# =============================================================================
# Aureon QA environment — template for /home/aureon/.env.qa (spec-48)
# =============================================================================
# This ONE file is parsed by THREE different consumers:
#   1. docker compose --env-file (Supabase QA stack, infra/supabase-qa)
#   2. systemd EnvironmentFile= (QA agents / worker services)
#   3. bash `source` (setup and deploy scripts)
# Therefore every value MUST stay simple: alphanumeric plus - _ . : / ,
# No quotes, no spaces, no $ signs, no # inside values, no shell expansion.
#
# NEVER put a *.supabase.co URL in this file — QA must never point at the
# production cloud project. All URLs here are localhost (tunnel access).
#
# Placeholders (CHANGE_ME_*) are filled in by infra/supabase-qa scripts —
# never commit a populated copy of this file.
#
# Vars match the official Supabase docker/.env.example at tag v1.26.07,
# minus analytics (Logflare), Vector, Supavisor (pooler), MinIO and TLS-proxy
# vars (those services are removed from the QA compose).
# =============================================================================

############
# Secrets (generated by generate-qa-secrets.sh)
############

POSTGRES_PASSWORD=CHANGE_ME_GENERATED_BY_SCRIPT
JWT_SECRET=CHANGE_ME_GENERATED_BY_SCRIPT_MIN_32_CHARS
# HS256-signed JWTs derived from JWT_SECRET
ANON_KEY=CHANGE_ME_GENERATED_BY_SCRIPT
SERVICE_ROLE_KEY=CHANGE_ME_GENERATED_BY_SCRIPT

# Asymmetric / opaque API keys — optional in self-hosted, left empty for QA
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# Supabase Studio (Kong basic-auth) dashboard login
DASHBOARD_USERNAME=CHANGE_ME_GENERATED_BY_SCRIPT
DASHBOARD_PASSWORD=CHANGE_ME_GENERATED_BY_SCRIPT

# Realtime / misc encryption keys
# SECRET_KEY_BASE: min 64 chars. REALTIME_DB_ENC_KEY: exactly 16 chars.
# PG_META_CRYPTO_KEY: min 32 chars.
SECRET_KEY_BASE=CHANGE_ME_GENERATED_BY_SCRIPT_MIN_64_CHARS
REALTIME_DB_ENC_KEY=CHANGE_ME_16CHAR
PG_META_CRYPTO_KEY=CHANGE_ME_GENERATED_BY_SCRIPT_32
S3_PROTOCOL_ACCESS_KEY_ID=CHANGE_ME_GENERATED_BY_SCRIPT
S3_PROTOCOL_ACCESS_KEY_SECRET=CHANGE_ME_GENERATED_BY_SCRIPT

############
# Ports (QA offsets — must not collide with prod services on
# 3100,3101,3102,3110,5678,5432,6379)
############

KONG_HTTP_PORT=8100
STUDIO_PORT=8101
# Postgres is published directly on the db container (Supavisor removed).
# The container listens on this port internally too.
POSTGRES_PORT=5433

############
# URLs — QA is reached through an SSH tunnel, so everything is localhost
############

SUPABASE_PUBLIC_URL=http://localhost:8100
API_EXTERNAL_URL=http://localhost:8100
SITE_URL=http://localhost:8100
ADDITIONAL_REDIRECT_URLS=

############
# Database
############

POSTGRES_HOST=db
POSTGRES_DB=postgres

############
# Studio
############

STUDIO_DEFAULT_ORGANIZATION=AureonQA
STUDIO_DEFAULT_PROJECT=AureonQA
OPENAI_API_KEY=

############
# Auth
############

JWT_EXPIRY=3600
DISABLE_SIGNUP=true
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
SMTP_ADMIN_EMAIL=qa@localhost.invalid
SMTP_HOST=localhost
SMTP_PORT=2500
SMTP_USER=qa_fake_mail_user
SMTP_PASS=qa_fake_mail_password
SMTP_SENDER_NAME=AureonQA
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

############
# Storage
############

GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub

############
# Edge Functions
############

FUNCTIONS_VERIFY_JWT=false

############
# PostgREST
############

PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

############
# imgproxy
############

IMGPROXY_AUTO_WEBP=true

# =============================================================================
# Aureon app services (QA instances) — NOT read by docker compose
# =============================================================================

############
# Frontend (QA build)
############

NEXT_PUBLIC_SUPABASE_URL=http://localhost:8100
# Same value as ANON_KEY above (frontend naming)
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGE_ME_GENERATED_BY_SCRIPT
# Same value as SERVICE_ROLE_KEY above (frontend server-side naming)
SUPABASE_SERVICE_KEY=CHANGE_ME_GENERATED_BY_SCRIPT

############
# Agents (apps/agents — validated by src/config.ts; all of these are REQUIRED
# or the process refuses to boot)
############

SUPABASE_URL=http://localhost:8100
# NOTE: agents require the _ROLE_ name (SUPABASE_SERVICE_ROLE_KEY), not
# SUPABASE_SERVICE_KEY. Same value as SERVICE_ROLE_KEY above.
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_GENERATED_BY_SCRIPT
# Prod Redis on 6379 db 0 — QA isolates into db 1 on the same instance
REDIS_URL=redis://localhost:6379/1
OPENROUTER_API_KEY=CHANGE_ME_OPENROUTER_KEY
# openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_GENERATED_BY_SCRIPT
# config.ts requires SENTRY_DSN non-empty. Use the QA Sentry project DSN,
# or an inert placeholder DSN if QA error reporting is not wanted.
SENTRY_DSN=CHANGE_ME_SENTRY_DSN
# Bull Board password must be at least 12 characters
BULL_BOARD_USER=CHANGE_ME_GENERATED_BY_SCRIPT
BULL_BOARD_PASSWORD=CHANGE_ME_GENERATED_BY_SCRIPT
# QA port remaps (prod defaults are 3110 / 3101)
HEALTH_PORT=3210
BULL_BOARD_PORT=3211

############
# Worker (apps/worker — direct Postgres connection to the QA db)
############

SUPABASE_DB_HOST=localhost
SUPABASE_DB_PORT=5433
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
# Same value as POSTGRES_PASSWORD above
SUPABASE_DB_PASSWORD=CHANGE_ME_GENERATED_BY_SCRIPT
NODE_ENV=production
WORKER_POLL_INTERVAL_MS=30000
