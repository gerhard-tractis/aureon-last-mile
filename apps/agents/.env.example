# @aureon/agents — environment
#
# On the VPS these live in /home/aureon/.env (chmod 600), read by
# deploy/aureon-agents.service via EnvironmentFile. Locally, copy this file to
# apps/agents/.env.
#
# NEVER commit a populated .env. Every var below is validated at startup by
# src/config.ts — a missing required var fails the process immediately with the
# list of what's missing, rather than surfacing later as a null dereference.

# ── Required ──────────────────────────────────────────────────────────────────

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# service_role key — Dashboard → Project Settings → API. Bypasses RLS.
# Note the name: the code requires SUPABASE_SERVICE_ROLE_KEY, not SUPABASE_SERVICE_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Redis connection for BullMQ, e.g. redis://127.0.0.1:6379
REDIS_URL=

# OpenRouter API key — powers manifest OCR (google/gemini-2.5-flash) and WISMO.
# The process will not start without it. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# AES-256-GCM key for encrypted connector fields (the ENCRYPTED: prefix).
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Sentry DSN for this service.
SENTRY_DSN=

# Bull Board dashboard credentials. Required — there are deliberately no
# defaults, because 'admin'/'changeme' previously shipped whenever these were
# unset. Password must be at least 12 characters.
# Generate: openssl rand -base64 24
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=

# ── Optional ──────────────────────────────────────────────────────────────────

# Shared secret for POST /api/ocr-extract on port 3110. If unset, the endpoint
# returns 500 rather than running unauthenticated.
# Generate: openssl rand -hex 32
OCR_API_SECRET=

# BetterStack heartbeat URL, pinged on a healthy loop.
BETTERSTACK_HEARTBEAT_URL=

# WhatsApp Business (WISMO agent)
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
WA_APP_SECRET=

# ── Dev only — never set these in production ──────────────────────────────────
#
# /dev/* routes expose bulk order purge and a state editor. They register only
# when ENABLE_DEV_ENDPOINTS=true AND NODE_ENV is not 'production'.
# ENABLE_DEV_ENDPOINTS=true
# AGENTS_DEV_TOKEN=
