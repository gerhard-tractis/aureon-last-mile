# untracked at the repo root by 2026-08.
.playwright-mcp/

# Estado de ejecucion de los hooks de .claude/hooks/. Cambian en cada fin de
# turno y son propios de cada worktree: versionarlos produce conflictos en
# cada merge. El interruptor .claude/keep-going.on SI se versiona, para que
# todo worktree nazca armado.
.claude/.keep-going-count
.claude/.keep-going-fp
.claude/BLOCKED.md
.claude/active-spec

# scratch extractor written by check-deploy-gating-pgnet-differential.test.sh
# at run time (PID-suffixed, removed by its own trap on exit) — a killed run
# can leave one behind.
scripts/.check-deploy-gating-pgnet-differential-extract.*.mjs
